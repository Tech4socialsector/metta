  {
   "fieldname": "pharmacy_items",
   "fieldtype": "Table",
   "label": "Pharmacy Items",
   "options": "Sales Bill Item"
  },
  {
   "depends_on": "eval:doc.bill_type=='Service' || doc.bill_type=='Mixed'",
   "fieldname": "service_section",
