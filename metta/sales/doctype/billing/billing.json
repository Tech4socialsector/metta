   "fieldname": "advance_adjusted",
   "fieldtype": "Currency",
   "label": "Advance Adjusted",
   "precision": "2"
  },
  {
   "fieldname": "amount_due",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Amount Due",
   "precision": "2",
   "read_only": 1
  },
  {
   "fieldname": "amount_collected",
   "fieldtype": "Currency",
   "label": "Amount Collected Now",
   "precision": "2"
  },
  {
   "depends_on": "eval:doc.net_amount > 0",
