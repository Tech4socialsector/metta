   "fieldtype": "Currency",
   "label": "Advance Collected",
   "precision": "2",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.registration_category==\"IP\"",
   "fieldname": "advance_used",
   "fieldtype": "Currency",
   "label": "Advance Used",
   "precision": "2",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.registration_category==\"IP\"",
