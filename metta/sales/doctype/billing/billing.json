   "fieldtype": "Currency",
   "label": "Subtotal",
   "precision": "2",
   "read_only": 1
  },
  {
   "description": "The real, full GST owed on the real selling price - never reduced by Discount %/Charity, same as it would be for a full-paying patient.",
   "fieldname": "gst_amount",
   "fieldtype": "Currency",
   "label": "GST Amount",
   "precision": "2",
   "read_only": 1
  },
  {
   "fetch_from": "billing_category.discount_percent",
   "fieldname": "discount_percent",
   "fieldtype": "Percent",
   "label": "Discount %"
  },
  {
   "description": "% applied to Subtotal + GST Amount combined - not to Subtotal alone, so GST itself is never reduced by this.",
   "fieldname": "discount_amount",
   "fieldtype": "Currency",
   "label": "Discount Amount",
   "precision": "2",
   "read_only": 1
  },
  {
   "fieldname": "net_amount",
   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Net Amount",
   "precision": "2",
   "read_only": 1
  },
  {
