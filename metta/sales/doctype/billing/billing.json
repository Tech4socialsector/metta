   "depends_on": "eval:doc.docstatus==0",
   "fieldname": "service_item_search_area",
   "fieldtype": "HTML",
   "label": "Add Service"
  },
  {
   "fieldname": "service_items",
   "fieldtype": "Table",
   "label": "Service Items",
   "options": "Sales Bill Item"
  },
  {
   "fieldname": "totals_section",
   "fieldtype": "Section Break",
   "label": "Total"
  },
  {
