   "fieldname": "pharmacy_section",
   "fieldtype": "Section Break",
   "label": "Pharmacy Items"
  },
  {
   "depends_on": "eval:doc.docstatus==0",
   "fieldname": "pharmacy_item_search_area",
   "fieldtype": "HTML",
   "label": "Add Medicine"
